# Salin ke .env dan isi nilainya. .env tidak pernah di-commit (SECURITY-COMPLIANCE T1).

# Meta Model API (H-028) — jalur otoritatif untuk run yang dilaporkan
MUSE_API_KEY=
MUSE_BASE_URL=

# OpenRouter — hanya untuk dev/uji (lihat keputusan dev provider)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Batas belanja dev dalam micro-USD (cost guard)
DEV_SPEND_CAP_MICRO_USD=4500000
